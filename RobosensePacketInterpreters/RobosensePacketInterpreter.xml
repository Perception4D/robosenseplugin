<ServerManagerConfiguration>
  <ProxyGroup name="internal_interpreter">
    <SourceProxy name="RobosensePacketInterpreter"
                 class="vtkRobosensePacketInterpreter"
                 label="Robosense Packet Interpreter"
                 base_proxygroup="internal_interpreter"
                 base_proxyname="CommonLidarPacketInterpreter">

      <IntVectorProperty name="LidarModel"
                         command="SetLidarModel"
                         number_of_elements="1"
                         override="1"
                         default_values="1">
        <!-- Theses values are mapped to enum LidarType (driver_param.hpp) -->
        <EnumerationDomain name="enum">
          <Entry value="1" text="RS16" />
          <Entry value="2" text="RS32" />
          <Entry value="3" text="BPerl" />
          <Entry value="4" text="RSAiry" />
          <Entry value="5" text="Helios" />
          <Entry value="6" text="Helios16P" />
          <Entry value="7" text="Ruby128" />
          <Entry value="8" text="Ruby80" />
          <Entry value="9" text="Ruby48" />
          <Entry value="10" text="RubyPlus128" />
          <Entry value="11" text="RubyPlus80" />
          <Entry value="12" text="RubyPlus48" />
          <Entry value="32" text="M1" />
          <Entry value="33" text="M2" />
          <Entry value="34" text="M3" />
          <Entry value="35" text="E1" />
          <Entry value="36" text="MX" />
        </EnumerationDomain>
        <Documentation>
          Process the data based on the chosen LiDAR model.
        </Documentation>
      </IntVectorProperty>

      <StringVectorProperty name="CalibrationFileName"
                            label="Calibration File"
                            animateable="0"
                            override="1"
                            command="SetCalibrationFileName"
                            panel_widget="calibration_file_widget"
                            number_of_elements="1">
        <FileListDomain name="files" />
        <Documentation>
          If specified, replace the default sensor calibration file.
        </Documentation>
        <Hints>
          <FileChooser extensions="json" file_description="Robosense LiDAR calibration files" />
        </Hints>
      </StringVectorProperty>
    </SourceProxy>
  </ProxyGroup>
</ServerManagerConfiguration>
