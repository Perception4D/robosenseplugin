<ServerManagerConfiguration>
  <ProxyGroup name="sources">
    <LidarStreamProxy name="RobosenseLidarStream"
                      class="vtkLidarStream"
                      label="Robosense LiDAR Stream"
                      base_proxygroup="internal_interpreter"
                      base_proxyname="CommonLidarStream">

      <Documentation short_help="Robosense LiDAR data stream." long_help="Robosense LiDAR live source stream.">
        Robosense LiDAR live source stream.
      </Documentation>

      <IntVectorProperty name="ListeningPort"
                         animateable="0"
                         command="SetListeningPort"
                         default_values="6699"
                         override="1"
                         number_of_elements="1">
        <Documentation>
        Specify port on which to listen for packets
        </Documentation>
      </IntVectorProperty>

      <SubProxy command="SetLidarInterpreter">
        <Proxy name="PacketInterpreter"
               proxygroup="internal_interpreter"
               proxyname="RobosensePacketInterpreter" />
        <ExposedProperties>
          <PropertyGroup label="LiDAR Interpreter Options">
            <Property name="TimeOffset" />
            <Property name="IgnoreZeroDistances" panel_visibility="advanced" />
            <Property name="IgnoreEmptyFrames" panel_visibility="advanced" />
            <Property name="FramingMethod" panel_visibility="advanced" />
            <Property name="FrameDuration" panel_visibility="advanced" />
          </PropertyGroup>
          <PropertyGroup label="LiDAR Transform">
            <Property name="Position" panel_visibility="advanced" />
            <Property name="Rotation" panel_visibility="advanced" />
          </PropertyGroup>
          <PropertyGroup label="Robosense Specific">
            <Property name="LidarModel" />
          </PropertyGroup>
          <Property name="Vendor" panel_visibility="never" />
          <Property name="ModelName" panel_visibility="never" />
        </ExposedProperties>
      </SubProxy>
      <Hints>
        <LiveSource refresh_on_interaction="1" />
        <View type="None" port="1" />
        <PipelineIcon name="SpreadSheetView" port="1" />
      </Hints>
    </LidarStreamProxy>
  </ProxyGroup>
</ServerManagerConfiguration>